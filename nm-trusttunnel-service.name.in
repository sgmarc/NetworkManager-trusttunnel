[VPN Connection]
name=trusttunnel
service=org.freedesktop.NetworkManager.trusttunnel
program=@LIBEXECDIR@/nm-trusttunnel-service
# The daemon keeps a single session, so two connections of this type must not
# be activated at the same time.
supports-multiple-connections=false
supports-safe-private-file-access=true

[libnm]
plugin=@PLUGINDIR@/libnm-vpn-plugin-trusttunnel.so

[GNOME]
auth-dialog=@LIBEXECDIR@/nm-trusttunnel-auth-dialog
properties=@PLUGINDIR@/libnm-vpn-plugin-trusttunnel.so
